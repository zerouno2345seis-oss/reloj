{
  "version": 2,
  "name": "quran-watch8-hub",
  "public": true,
  "cleanUrls": true,
  "outputDirectory": "pwa-web",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
