<?xml version="1.0" encoding="utf-8"?>
<!-- ring: Hijri date on top, the time between the Quran and bookmark
     buttons, the next prayer under it, "continue" at the bottom: the whole
     circle used evenly. One face per package, because WFF allows at most eight complication slots in a face. -->
<WatchFace width="450" height="450" clipShape="CIRCLE">
<Metadata key="CLOCK_TYPE" value="DIGITAL"/>
<Metadata key="PREVIEW_TIME" value="15:42:00"/>
<Scene backgroundColor="#FF000000">
<DigitalClock x="0" y="104" width="450" height="130"><TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="130"><Font family="SYNC_TO_DEVICE" size="112" weight="LIGHT" color="#FFFFFFFF"></Font></TimeText></DigitalClock>
<ComplicationSlot slotId="1" x="55" y="58" width="340" height="40" supportedTypes="LONG_TEXT SHORT_TEXT" isCustomizable="TRUE">
<Variant mode="AMBIENT" target="alpha" value="0"/>
<DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="LONG_TEXT" primaryProvider="com.quran.watch8/com.quran.watch8.complication.HijriDateComplicationService" primaryProviderType="LONG_TEXT"/>
<BoundingBox x="0" y="0" width="340" height="40"/>
<Complication type="LONG_TEXT"><PartText x="0" y="0" width="340" height="40"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" color="#FFC9A227"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
<Complication type="SHORT_TEXT"><PartText x="0" y="0" width="340" height="40"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" color="#FFC9A227"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
</ComplicationSlot>
<ComplicationSlot slotId="2" x="80" y="316" width="290" height="60" supportedTypes="SHORT_TEXT" isCustomizable="FALSE">
<Variant mode="AMBIENT" target="alpha" value="0"/>
<DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" primaryProvider="com.quran.watch8/com.quran.watch8.complication.ContinueReadingComplicationService" primaryProviderType="SHORT_TEXT"/>
<BoundingBox x="0" y="0" width="290" height="60"/>
<Complication type="SHORT_TEXT"><PartDraw x="0" y="0" width="290" height="60"><RoundRectangle x="0" y="0" width="290" height="60" cornerRadiusX="30" cornerRadiusY="30"><Fill color="#FF0F766E"/></RoundRectangle></PartDraw><PartText x="12" y="0" width="266" height="60"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="26" weight="BOLD" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
</ComplicationSlot>
<ComplicationSlot slotId="3" x="28" y="137" width="64" height="64" supportedTypes="SMALL_IMAGE SHORT_TEXT" isCustomizable="FALSE">
<Variant mode="AMBIENT" target="alpha" value="0"/>
<DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" primaryProvider="com.quran.watch8/com.quran.watch8.complication.QuranShortcutComplicationService" primaryProviderType="SMALL_IMAGE"/>
<BoundingOval x="0" y="0" width="64" height="64"/>
<Complication type="SMALL_IMAGE"><PartDraw x="0" y="0" width="64" height="64"><Ellipse x="0" y="0" width="64" height="64"><Fill color="#FF0F766E"/><Stroke color="#FFC9A227" thickness="1.5"/></Ellipse></PartDraw><PartImage x="14" y="14" width="36" height="36"><Image resource="[COMPLICATION.SMALL_IMAGE]"/></PartImage></Complication>
<Complication type="SHORT_TEXT"><PartText x="0" y="0" width="64" height="64"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="16" weight="NORMAL" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
</ComplicationSlot>
<ComplicationSlot slotId="6" x="358" y="137" width="64" height="64" supportedTypes="SMALL_IMAGE SHORT_TEXT" isCustomizable="FALSE">
<Variant mode="AMBIENT" target="alpha" value="0"/>
<DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE" primaryProvider="com.quran.watch8/com.quran.watch8.complication.BookmarksShortcutComplicationService" primaryProviderType="SMALL_IMAGE"/>
<BoundingOval x="0" y="0" width="64" height="64"/>
<Complication type="SMALL_IMAGE"><PartDraw x="0" y="0" width="64" height="64"><Ellipse x="0" y="0" width="64" height="64"><Fill color="#FF0F766E"/><Stroke color="#FFC9A227" thickness="1.5"/></Ellipse></PartDraw><PartImage x="14" y="14" width="36" height="36"><Image resource="[COMPLICATION.SMALL_IMAGE]"/></PartImage></Complication>
<Complication type="SHORT_TEXT"><PartText x="0" y="0" width="64" height="64"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="16" weight="NORMAL" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
</ComplicationSlot>
<ComplicationSlot slotId="5" x="0" y="0" width="450" height="450" supportedTypes="RANGED_VALUE" isCustomizable="FALSE">
<Variant mode="AMBIENT" target="alpha" value="0"/>
<DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="RANGED_VALUE" primaryProvider="com.quran.watch8/com.quran.watch8.complication.NextPrayerTimeComplicationService" primaryProviderType="RANGED_VALUE"/>
<BoundingBox x="45" y="236" width="360" height="76"/>
<Complication type="RANGED_VALUE"><PartText x="45" y="236" width="360" height="40"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="27" weight="BOLD" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText><PartText x="225" y="276" width="180" height="34"><Transform target="alpha" value="(255 * clamp(120 - ((([HOUR_0_23] * 60 + [MINUTE]) - floor([COMPLICATION.RANGED_VALUE_VALUE] / 1440) % 1440 + 1440) % 1440), 0, 1))"/><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="21" weight="NORMAL" color="#FF9CA3AF"><Template>%s س %s د<Parameter expression="floor(((([HOUR_0_23] * 60 + [MINUTE]) - floor([COMPLICATION.RANGED_VALUE_VALUE] / 1440) % 1440 + 1440) % 1440) / 60)"/><Parameter expression="(((([HOUR_0_23] * 60 + [MINUTE]) - floor([COMPLICATION.RANGED_VALUE_VALUE] / 1440) % 1440 + 1440) % 1440) % 60)"/></Template></Font></Text></PartText><PartText x="225" y="276" width="180" height="34"><Transform target="alpha" value="(255 * clamp(((([HOUR_0_23] * 60 + [MINUTE]) - floor([COMPLICATION.RANGED_VALUE_VALUE] / 1440) % 1440 + 1440) % 1440) - 119, 0, 1))"/><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="21" weight="NORMAL" color="#FF9CA3AF"><Template>%s س<Parameter expression="floor(((([HOUR_0_23] * 60 + [MINUTE]) - floor([COMPLICATION.RANGED_VALUE_VALUE] / 1440) % 1440 + 1440) % 1440) / 60)"/></Template></Font></Text></PartText><PartText x="45" y="276" width="180" height="34"><Transform target="alpha" value="(255 * clamp(120 - (([COMPLICATION.RANGED_VALUE_VALUE] % 1440 - ([HOUR_0_23] * 60 + [MINUTE]) + 1440) % 1440), 0, 1))"/><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="21" weight="NORMAL" color="#FFC9A227"><Template>%s س %s د<Parameter expression="floor((([COMPLICATION.RANGED_VALUE_VALUE] % 1440 - ([HOUR_0_23] * 60 + [MINUTE]) + 1440) % 1440) / 60)"/><Parameter expression="((([COMPLICATION.RANGED_VALUE_VALUE] % 1440 - ([HOUR_0_23] * 60 + [MINUTE]) + 1440) % 1440) % 60)"/></Template></Font></Text></PartText><PartText x="45" y="276" width="180" height="34"><Transform target="alpha" value="(255 * clamp((([COMPLICATION.RANGED_VALUE_VALUE] % 1440 - ([HOUR_0_23] * 60 + [MINUTE]) + 1440) % 1440) - 119, 0, 1))"/><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="21" weight="NORMAL" color="#FFC9A227"><Template>%s س<Parameter expression="floor((([COMPLICATION.RANGED_VALUE_VALUE] % 1440 - ([HOUR_0_23] * 60 + [MINUTE]) + 1440) % 1440) / 60)"/></Template></Font></Text></PartText></Complication>
</ComplicationSlot>
<!-- Last: it spans the face to draw its arc, and a slot listed earlier would take every tap meant for the buttons. -->
<ComplicationSlot slotId="0" x="0" y="0" width="450" height="450" supportedTypes="RANGED_VALUE" isCustomizable="TRUE">
<DefaultProviderPolicy defaultSystemProvider="EMPTY" defaultSystemProviderType="RANGED_VALUE" primaryProvider="com.quran.watch8/com.quran.watch8.complication.NextPrayerComplicationService" primaryProviderType="RANGED_VALUE"/>
<BoundingArc centerX="225" centerY="225" width="438" height="438" startAngle="0" endAngle="359.9" thickness="30"/>
<Complication type="RANGED_VALUE"><PartDraw x="0" y="0" width="450" height="450"><Variant mode="AMBIENT" target="alpha" value="0"/><Arc centerX="225" centerY="225" width="438" height="438" startAngle="0" endAngle="0"><Transform target="endAngle" value="(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]) * 360)"/><Stroke color="#FFC9A227" thickness="8" cap="ROUND"/></Arc></PartDraw><PartDraw x="0" y="0" width="450" height="450" alpha="0"><Variant mode="AMBIENT" target="alpha" value="255"/><Arc centerX="225" centerY="225" width="438" height="438" startAngle="0" endAngle="0"><Transform target="endAngle" value="(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]) * 360)"/><Stroke color="#FF6B7280" thickness="2" cap="ROUND"/></Arc></PartDraw></Complication>
</ComplicationSlot>
</Scene></WatchFace>
