<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The app's own window does not close on a swipe to the right: inside the
        app that swipe goes back to the surah list, and only the watch's
        buttons leave it.
    -->
    <style name="Theme.Reloj.Main" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>
